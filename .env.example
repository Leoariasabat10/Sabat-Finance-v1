# Supabase — panel del proyecto > Settings > API Keys
# NEXT_PUBLIC_SUPABASE_URL se usa para construir las URLs publicas de Storage.
# SUPABASE_SERVICE_ROLE_KEY es secreta (nunca debe llevar el prefijo NEXT_PUBLIC):
# esta app no usa Supabase Auth, asi que las subidas de fotos pasan por esta
# clave en el servidor en vez de por una sesion de usuario.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Supabase — panel del proyecto > Settings > Database > Connection string
# DATABASE_URL usa el pooler (puerto 6543), DIRECT_URL la conexion directa (5432)
DATABASE_URL=postgresql://postgres.TU-PROYECTO:TU-PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.TU-PROYECTO:TU-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# WhatsApp Cloud API (Meta) — Meta for Developers > tu app > WhatsApp > Configuracion de la API
# WHATSAPP_TOKEN: token de acceso permanente del System User
# WHATSAPP_PHONE_NUMBER_ID: el Phone Number ID (no el numero de telefono en si)
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345
