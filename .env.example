# Supabase — panel del proyecto > Settings > API Keys
# NEXT_PUBLIC_SUPABASE_URL se usa para construir las URLs publicas de Storage
# y como endpoint de Supabase Auth.
# NEXT_PUBLIC_SUPABASE_ANON_KEY es publica/segura para el navegador — la usa
# el login de administrador (Supabase Auth, integración 28 sep 2026).
# las subidas de fotos (Storage) pasan por esta clave en el servidor.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Supabase — panel del proyecto > Settings > Database > Connection string
# DATABASE_URL usa el pooler (puerto 6543), DIRECT_URL la conexion directa (5432)
DATABASE_URL=postgresql://postgres.TU-PROYECTO:TU-PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.TU-PROYECTO:TU-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# WhatsApp Cloud API (Meta) — Meta for Developers > tu app > WhatsApp > Configuracion de la API
# WHATSAPP_TOKEN: token de acceso permanente del System User
# WHATSAPP_PHONE_NUMBER_ID: el Phone Number ID (no el numero de telefono en si)
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# ── Acceso (obligatorio en producción) ───────────────────────────────────────────────────────────
# Correos que pueden entrar a Sabat Finance, separados por coma. Además entra cualquier cuenta con
# app_metadata.rol = "admin". Sin esto NADIE entra: el registro abierto de Supabase Auth no da acceso.
ADMIN_EMAILS=

# ── Base de datos unificada ──────────────────────────────────────────────────────────────────────
# Finance vive en el MISMO proyecto Supabase que SABAT Joyería, en el esquema "finance" (las tablas de la tienda
# quedan en "public"). Por eso las dos cadenas de conexión terminan en `schema=finance`:
#   DATABASE_URL=postgresql://postgres.<ref>:<clave>@aws-X.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=finance
#   DIRECT_URL=postgresql://postgres.<ref>:<clave>@aws-X.pooler.supabase.com:5432/postgres?schema=finance

# Mi Sistema (disciplina personal): correos con acceso, separados por comas. Vacío = nadie entra.
SISTEMA_EMAILS=
